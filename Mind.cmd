@echo off
setlocal
set "MIND_RAIZ=%~dp0"
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -Command "try { $ErrorActionPreference='Stop'; [Console]::OutputEncoding=[Text.UTF8Encoding]::new($false); function GetMindRuntimeHash($p) { $f=[IO.File]::OpenRead($p); $s=[Security.Cryptography.SHA256]::Create(); try { return [BitConverter]::ToString($s.ComputeHash($f)).Replace('-','').ToLowerInvariant() } finally { $f.Dispose(); $s.Dispose() } }; $r=[IO.Path]::GetFullPath($env:MIND_RAIZ).TrimEnd([char]92);  $a=[Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant(); if ($a -notin @('x64','arm64')) { throw 'Mind admite Windows x64 y ARM64' }; $d=Join-Path $r ('Motor\Runtime\win32-'+$a); $n=Join-Path $d 'node.exe'; $m=Get-Content -Raw -LiteralPath (Join-Path $d 'procedencia.json') | ConvertFrom-Json; $h=(GetMindRuntimeHash $n); if ($h -ne $m.sha256Node) { throw 'Runtime alterado: use una copia oficial para recuperar Mind' }; $c=Join-Path ([IO.Path]::GetTempPath()) ('mind-node-'+$h.Substring(0,16)+'.exe'); if (($c.Length+13) -ge 260) { throw ('La carpeta temporal tiene una ruta demasiado larga para Windows ('+$c.Length+' caracteres). Use una variable TEMP con una ruta corta.') }; $ok=$false; if (Test-Path -LiteralPath $c) { try { $ok=((GetMindRuntimeHash $c) -eq $h) } catch {} }; if (!$ok) { $t=$c+'.'+[guid]::NewGuid().ToString('N').Substring(0,8)+'.tmp'; Copy-Item -LiteralPath $n -Destination $t; try { Move-Item -LiteralPath $t -Destination $c -Force } catch { Remove-Item -LiteralPath $t -Force -ErrorAction SilentlyContinue } }; if ((GetMindRuntimeHash $c) -ne $h) { throw ('La copia temporal de Node no coincide. Cierre otras ventanas de Mind y repita; si persiste, borre '+$c) }; $v=(Get-Date).AddHours(-1); Get-ChildItem -LiteralPath ([IO.Path]::GetTempPath()) -Filter 'mind-node-*' -File -ErrorAction SilentlyContinue | Where-Object { $_.FullName -ne $c -and ($_.Extension -eq '.exe' -or $_.LastWriteTime -lt $v) } | ForEach-Object { Remove-Item -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue }; & $c (Join-Path $r 'Motor\Distribucion\gestionar.mjs') $r $env:MIND_PEDIDO; exit $LASTEXITCODE } catch { [Console]::Error.WriteLine($_.Exception.Message); exit 2 }"
exit /b %errorlevel%
